{
  "name": "@taskall/react",
  "version": "0.1.0",
  "description": "TaskAll Design System — React components, tokens and icons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanlinscosta/taskall-design-system.git",
    "directory": "library"
  },
  "homepage": "https://github.com/ivanlinscosta/taskall-design-system#readme",
  "bugs": {
    "url": "https://github.com/ivanlinscosta/taskall-design-system/issues"
  },
  "keywords": [
    "taskall",
    "design-system",
    "react",
    "components",
    "tokens",
    "icons"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:icons": "tsx scripts/generate-icons.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.10.3",
    "esbuild": "^0.28.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
